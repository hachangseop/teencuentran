# Copia a .env.local y completa con tus valores de Supabase.
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Google OAuth (Supabase Dashboard → Authentication → Providers → Google):
# 1. Crea credenciales OAuth en Google Cloud Console.
# 2. Redirect URL autorizada: https://tu-proyecto.supabase.co/auth/v1/callback
# 3. Site URL en Supabase → Authentication → URL Configuration: https://teencuentran.mx
